<odoo>
  <!-- Vista del wizard -->
  <record id="view_bice_export_wizard" model="ir.ui.view">
    <field name="name">bice.export.wizard.form</field>
    <field name="model">bice.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Exportar BICE Proveedores">
        <group>
          <field name="filename" string="Nombre del archivo"/>
        </group>
        <footer>
          <button string="Generar archivo" name="action_generate" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Acción para abrir el wizard en modal -->
  <record id="action_bice_export_wizard" model="ir.actions.act_window">
    <field name="name">Exportar BICE Proveedores</field>
    <field name="res_model">bice.export.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="view_id" ref="view_bice_export_wizard"/>
  </record>
</odoo>
