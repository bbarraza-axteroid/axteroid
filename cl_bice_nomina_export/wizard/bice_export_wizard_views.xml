<odoo>
    <record id="view_bice_export_wizard" model="ir.ui.view">
        <field name="name">bice.export.wizard.form</field>
        <field name="model">bice.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar BICE Proveedores">
                <group>
                    <field name="batch_id" invisible="1"/>
                </group>
                <group>
                    <field name="archivo" filename="nombre"/>
                    <field name="nombre" invisible="1"/>
                </group>
                <footer>
                    <button string="Generar archivo" name="action_generate" type="object" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
