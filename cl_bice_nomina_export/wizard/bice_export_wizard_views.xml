<odoo>
    <record id="view_bice_export_wizard" model="ir.ui.view">
        <field name="name">bice.export.wizard.form</field>
        <field name="model">bice.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar BICE Proveedores">
                <group>
                    <label string="Este asistente generará el archivo y lo adjuntará al lote."/>
                </group>
                <footer>
                    <button string="Generar archivo" type="object"
                            name="action_generate" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
