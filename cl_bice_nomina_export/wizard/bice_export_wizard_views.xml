<odoo>
    <record id="view_bice_export_wizard_form" model="ir.ui.view">
        <field name="name">bice.export.wizard.form</field>
        <field name="model">bice.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar Nómina BICE">
                <group>
                    <field name="file_data" filename="file_name" readonly="1"/>
                    <field name="file_name" readonly="1"/>
                </group>
                <footer>
                    <button name="export_bice_proveedores_file" type="object" string="Generar Archivo" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
