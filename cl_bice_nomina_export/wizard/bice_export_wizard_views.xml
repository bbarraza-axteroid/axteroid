<odoo>
    <!-- Acción del wizard (la usará el botón del lote) -->
    <record id="action_bice_export_wizard" model="ir.actions.act_window">
        <field name="name">Exportar BICE Proveedores</field>
        <field name="res_model">bice.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_batch_id': active_id}</field>
    </record>

    <!-- Vista del wizard -->
    <record id="view_bice_export_wizard" model="ir.ui.view">
        <field name="name">view.bice.export.wizard.form</field>
        <field name="model">bice.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar BICE Proveedores">
                <group>
                    <field name="archivo" filename="nombre" readonly="1"/>
                    <field name="nombre"/>
                </group>
                <footer>
                    <button string="Generar archivo"
                            name="action_generate"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
