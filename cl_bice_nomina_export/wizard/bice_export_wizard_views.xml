<!-- cl_bice_nomina_export/wizard/bice_export_wizard_views.xml -->
<odoo>
  <record id="view_bice_export_wizard" model="ir.ui.view">
    <field name="name">view.bice.export.wizard.form</field>
    <field name="model">bice.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Exportar BICE Proveedores">
        <group>
          <!-- OJO: aquí NO hay <field name="filename"/> -->
          <field name="archivo" filename="nombre" readonly="1"/>
          <field name="nombre"/>
        </group>
        <footer>
          <button string="Guardar" type="object" name="action_generate" class="btn-primary"/>
          <button string="Descartar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
