<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista heredada del formulario de Pagos en Lote -->
    <record id="view_batch_payment_form_bice" model="ir.ui.view">
        <field name="name">account.batch.payment.form.bice</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_account_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_bice_nomina"
                        type="object"
                        string="Exportar BICE Proveedores"
                        class="oe_highlight"
                        invisible="payment_type != 'outbound'"/>
            </xpath>
        </field>
    </record>
</odoo>
