<odoo>

  <record id="view_batch_payment_form_bice" model="ir.ui.view">
    <field name="name">account.batch.payment.form.bice</field>
    <field name="model">account.batch.payment</field>
    <field name="inherit_id" ref="account.view_account_batch_payment_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_export_bice_nomina" type="object" string="Exportar BICE Proveedores" class="oe_highlight" attrs="{'invisible': [('payment_type','!=','outbound')]}"/>
      </xpath>
    </field>
  </record>

    <record id="view_batch_payment_form_bice" model="ir.ui.view">
        <field name="name">account.batch.payment.form.bice</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
<button name="export_bice_proveedores_file"
                        type="object"
                        string="Exportar BICE Proveedores"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

</odoo>
