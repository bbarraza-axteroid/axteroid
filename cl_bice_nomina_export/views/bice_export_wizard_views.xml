<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_bice_export_wizard" model="ir.ui.view">
    <field name="name">bice.export.wizard.form</field>
    <field name="model">bice.export.wizard</field>
    <field name="arch" type="xml">
      <form string="Exportar archivo BICE Proveedores">
        <group>
          <field name="batch_id"/>
          <field name="journal_id"/>
          <field name="execution_date"/>
          <field name="factura_default"/>
          <field name="include_email"/>
          <field name="include_header"/>
          <field name="encoding"/>
        </group>
        <div>
          <field name="layout_help" readonly="1"/>
        </div>
        <footer>
          <button name="action_generate"
                  type="object"
                  string="Generar_Archivo"
                  class="btn-primary"/>
          <button special="cancel" string="Cancelar"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_bice_export_wizard" model="ir.actions.act_window">
    <field name="name">Exportar archivo BICE</field>
    <field name="res_model">bice.export.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
